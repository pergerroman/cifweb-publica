DirectoryIndex index.html
ErrorDocument 404 /404.html

<IfModule mod_rewrite.c>
  RewriteEngine On

  # Dominio canónico: HTTPS sin www. Solo se aplica en producción.
  RewriteCond %{HTTP_HOST} ^(?:www\.)?clubcif\.com$ [NC]
  RewriteCond %{HTTPS} !=on [OR]
  RewriteCond %{HTTP_HOST} ^www\.clubcif\.com$ [NC]
  RewriteRule ^ https://clubcif.com%{REQUEST_URI} [R=301,L,NE]

  # Compatibilidad con la ruta usada durante el desarrollo inicial.
  RewriteRule ^club-cif-vacaciones/?$ /vacaciones/ [R=301,L,NE]

  # Alias corto del Festival; la ruta larga se mantiene como canónica.
  RewriteRule ^fpg/?$ /festival-patagonico-de-gimnasia/ [R=301,L,NE]
</IfModule>

<IfModule mod_headers.c>
  <FilesMatch "\.(?:html?|css|js)$">
    Header set Cache-Control "no-cache, must-revalidate"
  </FilesMatch>

  <FilesMatch "\.(?:avif|gif|jpe?g|png|svg|webp|glb|ktx2|ttf|woff2?)$">
    Header set Cache-Control "public, max-age=604800, must-revalidate"
  </FilesMatch>
</IfModule>

<IfModule mod_expires.c>
  ExpiresActive On
  ExpiresByType text/html "access plus 0 seconds"
  ExpiresByType text/css "access plus 0 seconds"
  ExpiresByType application/javascript "access plus 0 seconds"
</IfModule>
